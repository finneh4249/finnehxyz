---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSectionMeta } from '../../utils/seo';

const seoMeta = getSectionMeta('blog') as { title: string; description: string };

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [heroPost, ...remainingPosts] = sortedPosts;

function isoDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<BaseLayout title={seoMeta.title} description={seoMeta.description}>
  <div class="signal-grid-bg" aria-hidden="true"></div>

  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center px-6 md:px-12 py-3 bg-signal-black/95 border-b border-signal-white/8 backdrop-blur-sm" role="navigation" aria-label="Main Navigation">
    <a href="/" class="font-display font-black text-lg text-signal-white tracking-tighter uppercase flex items-center border-2 border-signal-orange px-4 py-1 hover:bg-signal-orange hover:text-signal-black transition-colors duration-200">
      ETHAN CORNWILL
    </a>
    <div class="flex items-center gap-8 md:gap-12">
      <a href="/resume" class="font-mono text-[10px] uppercase tracking-[0.4em] text-signal-white/50 hover:text-signal-white transition-colors">Resume</a>
      <a href="/blog" class="font-mono text-[10px] uppercase tracking-[0.4em] text-signal-orange hover:text-signal-white transition-colors">Blog</a>
    </div>
  </nav>

  <main class="pt-[52px] min-h-screen">

    <!-- Header band -->
    <div class="surface-orange px-6 md:px-12 py-8 md:py-12">
      <div class="max-w-[1800px] mx-auto flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <p class="font-mono text-signal-black/60 text-xs uppercase tracking-[0.5em] mb-2">
            <a href="/" class="hover:text-signal-black transition-colors">Home</a>
            <span class="mx-2 opacity-40">/</span>
            Blog
          </p>
          <h1 class="text-signal-black tracking-tighter leading-none" style="font-size:clamp(2.5rem,7vw,8rem)">
            Dispatch
          </h1>
        </div>
        <p class="text-signal-black/60 font-mono text-xs max-w-xs leading-relaxed">
          {sortedPosts.length} {sortedPosts.length === 1 ? 'entry' : 'entries'} — AI engineering, prompt architecture, and production systems.
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="px-6 md:px-12 py-12">
      <div class="max-w-[1800px] mx-auto">

        {sortedPosts.length === 0 ? (
          <div class="py-24 text-center">
            <p class="font-mono text-sm text-signal-white/30 uppercase tracking-[0.35em]">
              // buffer empty — no entries found
            </p>
          </div>
        ) : (
          <>
            <!-- Hero: latest dispatch -->
            <article class="border border-signal-white/12 border-t-4 border-t-signal-orange bg-signal-charcoal hover:shadow-signal-lg transition-all duration-300 group mb-10">
              <a href={`/blog/${heroPost.id}`} class="block p-8 md:p-12">

                <div class="flex flex-wrap items-center gap-3 mb-6">
                  <span class="font-mono text-[9px] uppercase tracking-[0.45em] text-signal-orange">latest dispatch</span>
                  <span class="text-signal-white/20 font-mono">·</span>
                  <time
                    class="font-mono text-[10px] uppercase tracking-[0.3em] text-signal-white/40"
                    datetime={heroPost.data.pubDate.toISOString()}
                  >
                    {isoDate(heroPost.data.pubDate)}
                  </time>
                  {heroPost.data.tags?.[0] && (
                    <span class="committed-cyan text-[9px] font-mono uppercase tracking-[0.2em] text-signal-cyan px-2 py-0.5">
                      {heroPost.data.tags[0]}
                    </span>
                  )}
                </div>

                <h2
                  class="text-signal-white group-hover:text-signal-orange transition-colors leading-tight not-italic mb-6 max-w-4xl"
                  style="font-size:clamp(2rem,5vw,4.5rem)"
                >
                  {heroPost.data.title}
                </h2>

                <p class="text-signal-white/65 leading-relaxed mb-8 max-w-2xl" style="font-size:clamp(0.95rem,1.3vw,1.1rem)">
                  {heroPost.data.description}
                </p>

                <span class="signal-btn pointer-events-none">OPEN TRANSMISSION →</span>

              </a>
            </article>

            <!-- Departure log: remaining posts -->
            {remainingPosts.length > 0 && (
              <div>
                <p class="font-mono text-[9px] uppercase tracking-[0.5em] text-signal-white/20 pb-3 border-b border-signal-white/8">
                  — previous dispatches ({remainingPosts.length}) —
                </p>

                {remainingPosts.map((post: CollectionEntry<'blog'>) => (
                  <a
                    href={`/blog/${post.id}`}
                    class="flex items-center gap-4 md:gap-8 py-4 border-b border-signal-white/8 hover:bg-signal-charcoal group transition-colors"
                  >
                    <time
                      class="font-mono text-[10px] text-signal-white/30 uppercase tracking-[0.2em] shrink-0 hidden md:block w-28"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      {isoDate(post.data.pubDate)}
                    </time>

                    {post.data.tags?.[0] && (
                      <span class="committed-cyan text-[9px] font-mono uppercase tracking-[0.15em] text-signal-cyan px-2 py-0.5 shrink-0 hidden sm:block">
                        {post.data.tags[0]}
                      </span>
                    )}

                    <span
                      class="font-display font-black uppercase italic tracking-tight text-signal-white group-hover:text-signal-orange transition-colors flex-1 leading-tight"
                      style="font-size:clamp(0.9rem,1.4vw,1.1rem)"
                    >
                      {post.data.title}
                    </span>

                    <span class="text-signal-orange font-black text-base shrink-0 group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                ))}
              </div>
            )}
          </>
        )}

        <div class="mt-12 text-center">
          <a href="/" class="font-mono text-xs text-signal-white/30 hover:text-signal-orange transition-colors">
            ← back to home
          </a>
        </div>

      </div>
    </div>

  </main>
</BaseLayout>
